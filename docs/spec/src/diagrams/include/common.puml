' Shared theme and the language switch for every SDS diagram.
' Include with:   !include include/common.puml
' Write every label as $t("ภาษาไทย", "English"). The renderer builds both languages from one source:
' without a flag the Thai text is used, with -DLANG_EN the English text.
!pragma layout smetana
!function $t($th, $en)
!ifdef LANG_EN
!return $en
!else
!return $th
!endif
!endfunction

skinparam shadowing false
skinparam defaultFontName "Leelawadee UI"
skinparam defaultFontSize 13
skinparam defaultTextAlignment center
skinparam roundCorner 10
skinparam dpi 150
skinparam BackgroundColor #FFFFFF
skinparam ArrowColor #5B6270
skinparam ArrowFontSize 12
skinparam ArrowThickness 1.2
skinparam NoteBackgroundColor #E8F5EC
skinparam NoteBorderColor #15803D
skinparam NoteFontSize 12
skinparam TitleFontSize 16
skinparam TitleFontStyle bold
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #D7DAE0
skinparam LegendFontSize 12

